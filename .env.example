DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,survey.ylawteam.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://survey.ylawteam.com
DJANGO_PUBLIC_HOST=survey.ylawteam.com
DJANGO_DEFAULT_SURVEY_SLUG=joint-project-risk-diagnosis
DJANGO_SECURE_COOKIES=true

POSTGRES_DB=ylaw_survey
POSTGRES_USER=ylaw_survey
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=replace-with-a-strong-admin-password

BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
